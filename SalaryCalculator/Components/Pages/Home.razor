@page "/"

<PageTitle>Lønnskalkulator</PageTitle>

<h1>Lønnskalkulator</h1>

<p>Før opp vaktene dine og se hva du får utbetalt, med kvelds-, helge- og helligdagstillegg.</p>

<AuthorizeView>
    <Authorized>
        <p>Hei, @context.User.Identity?.Name!</p>
        <a class="btn btn-primary" href="period">Gå til vaktlisten</a>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-primary" href="Account/Login">Logg inn</a>
        <a class="btn btn-outline-primary" href="Account/Register">Registrer deg</a>
    </NotAuthorized>
</AuthorizeView>