@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>

        <footer class="footer px-4">
            Laget av Zarrar Ahmed &copy; @DateTime.Now.Year
            · <a href="https://github.com/ZarrarAh/SalaryCalculator" target="_blank">GitHub</a>
